<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>roadster_gz_plugins</name>
    <version>0.1.0</version>
    <description>Gazebo Fortress system for the stunt roadster: compressed-air tank, cold-gas
        nozzles and suction fan in one force-writing system, plus their pure-math models.</description>
    <maintainer email="tju.fanke@gmail.com">kefan</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <depend>ignition-gazebo6</depend>
    <depend>yaml-cpp</depend>
    <depend>nlohmann-json-dev</depend>
    <test_depend>ament_cmake_gtest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
