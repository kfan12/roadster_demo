<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>roadster_control</name>
    <version>0.1.0</version>
    <description>Stunt roadster mission FSM and flight control: quaternion attitude PD, flip
        reference, landing brake burn, OSQP thrust allocator.</description>
    <maintainer email="tju.fanke@gmail.com">kefan</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <depend>rclcpp</depend>
    <depend>std_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>nlohmann-json-dev</depend>
    <depend>ros_gz_interfaces</depend>
    <depend>av_feature_msgs</depend>
    <depend>eigen</depend>
    <depend>yaml-cpp</depend>
    <exec_depend>roadster_description</exec_depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>visualization_msgs</exec_depend>
    <exec_depend>rviz2</exec_depend>
    <test_depend>ament_cmake_gtest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
