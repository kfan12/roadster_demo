<?xml version="1.0"?>
<sdf version="1.8">
  <model name="ground_asphalt">
    <static>true</static>
    <link name="link">
      <!-- Visual only: the world's ground model keeps its <plane> collision for
           physics; this supplies the tiled asphalt look. -->
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://ground_asphalt/meshes/ground.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
