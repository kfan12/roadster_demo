<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="roadster">

    <!-- Stunt roadster, derived from sedan_description/urdf/sedan.urdf.xacro
       (docs/plans/roadster_demo_plan.md). Kept from the sedan: chassis/body
       collision box, wheelbase/track/wheel geometry, steering-joint limits,
       wheel-friction blob path, IMU (same noise), base_link at ground level.
       Changed, and why:
       - drive: the sedan's AckermannSteering plugin commands wheel joint
         VELOCITIES (capped at 10 m/s, 4 m/s^2), so it would brake the car
         against a thruster burst. Here gz_ros2_control drives the wheels by
         EFFORT (all-wheel drive) and the steering joints by POSITION
         (config/ros2_controllers.yaml); DART friction sets the traction limit.
       - odometry: ground truth is 3D (dimensions=3) because the car flips;
         there is no wheel odometry yet (the Ackermann plugin produced it).
       - sensors: force/torque on every wheel joint (wheel normal force, needed
         by the fan loop and the inverted-hold checks) and a chassis contact
         sensor (landing impact / body scrape).
       - nozzle frames: one fixed frame per cold-gas nozzle, placed from
         config/nozzles.yaml (the same file the thruster plugin will read).
       - camera: off by default (with_camera:=true restores the sedan's RGB-D
         block verbatim); software-GL rendering cannot keep up with the 1 ms
         stunt physics step.
       - mass: chassis_mass is an argument; tire friction mu = 1.2 (plan
         section 7) instead of the sedan's 1.0.
       Thrust/fan forces are applied by the Gazebo systems of Phase 2/4, not
       declared here. -->

    <xacro:arg name="with_camera" default="false" />
    <!-- 1690 kg chassis + 4 x 10 kg suspension links + 4 x 15 kg wheels + 2 x 5 kg
       steer links = 1,800 kg total (1730 before the suspension was added),
       the plan's nominal mass. The sedan stays at 300 kg "for stability"; this
       mass was verified stable on the 1 ms DART flat-runway smoke test
       (2026-10-16: wheel loads = sprung weight within 0.1%, traction-limited
       0-60 in 2.30 s at both 300 and 1,800 kg). -->
    <xacro:arg name="chassis_mass" default="1690" />
    <xacro:arg name="tire_mu" default="1.2" />
    <xacro:arg name="controllers_file"
        default="$(find roadster_description)/config/ros2_controllers.yaml" />
    <!-- actuation (roadster_gz_plugins): the world's analytic surfaces for the
       fan gap (maps/<world>.json, passed in by the launch file; empty = z = 0
       ground plane) and the fan's spin state at spawn (1.0 lets a car spawned
       against a ceiling hold from t = 0 instead of falling during spin-up) -->
    <xacro:arg name="surfaces_file" default="" />
    <!-- cosmetic Gazebo particle plumes on the nozzles and fan exhausts -->
    <xacro:arg name="with_effects" default="true" />
    <xacro:arg name="fan_initial_speed" default="0.0" />

    <!-- ===================== PHYSICAL PARAMETERS ===================== -->
    <xacro:property name="wheelbase" value="2.7" />
    <xacro:property name="track_width" value="1.6" />
    <xacro:property name="wheel_radius" value="0.33" />
    <xacro:property name="wheel_width" value="0.25" />

    <xacro:property name="ch_l" value="4.5" />
    <xacro:property name="ch_w" value="1.8" />
    <xacro:property name="ch_h" value="0.15" />
    <xacro:property name="ch_mass" value="$(arg chassis_mass)" />

    <!-- visual only: lower, wedge-like roadster shell instead of the sedan's
       box + greenhouse. The collision box below is the sedan's, unchanged. -->
    <xacro:property name="body_l" value="4.2" />
    <xacro:property name="body_w" value="1.75" />
    <xacro:property name="body_h" value="0.55" />
    <xacro:property name="cabin_l" value="1.4" />
    <xacro:property name="cabin_w" value="1.5" />
    <xacro:property name="cabin_h" value="0.30" />

    <xacro:property name="steer_mass" value="5.0" />
    <xacro:property name="wheel_mass" value="15.0" />

    <!-- wheel joint limits for the effort interface. velocity 200 rad/s =
       66 m/s at r = 0.33 m, above any planned thrust speed. effort 2500 N.m
       per wheel is above the traction limit at the heaviest planned mass
       (mu 1.2 x 1,870 kg x g / 4 x 0.33 m ~ 1,820 N.m), so friction, not this
       clamp, is what binds; the drive controller owns the real torque limit. -->
    <xacro:property name="wheel_effort_max" value="2500.0" />
    <xacro:property name="wheel_velocity_max" value="200.0" />

    <!-- camera mount: identical to sedan.urdf.xacro (see the history there) -->
    <xacro:property name="cam_x" value="2.2" />
    <xacro:property name="cam_z" value="1.4" />
    <xacro:property name="cam_pitch" value="0.06" />

    <xacro:property name="nozzles"
        value="${xacro.load_yaml('$(find roadster_description)/config/nozzles.yaml')['nozzles']}" />

    <!-- ===================== INERTIA MACROS ===================== -->
    <xacro:macro name="box_inertia" params="m x y z">
        <inertial>
            <mass value="${m}" />
            <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
                iyy="${m*(x*x+z*z)/12}" iyz="0"
                izz="${m*(x*x+y*y)/12}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="cyl_inertia" params="m r h">
        <inertial>
            <mass value="${m}" />
            <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
                iyy="${m*(3*r*r+h*h)/12}" iyz="0"
                izz="${m*r*r/2}" />
        </inertial>
    </xacro:macro>

    <!-- ===================== BASE LINK ===================== -->
    <link name="base_link" />

    <!-- ===================== CHASSIS ===================== -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link" />
        <child link="chassis" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    <link name="chassis">
        <!-- floor pan -->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="${ch_l} ${ch_w} ${ch_h}" />
            </geometry>
            <material name="anthracite">
                <color rgba="0.18 0.18 0.18 1.0" />
            </material>
        </visual>
        <!-- body shell -->
        <visual>
            <origin xyz="0 0 ${ch_h/2 + body_h/2}" rpy="0 0 0" />
            <geometry>
                <box size="${body_l} ${body_w} ${body_h}" />
            </geometry>
            <material name="roadster_red">
                <color rgba="0.70 0.05 0.07 1.0" />
            </material>
        </visual>
        <!-- low canopy, set back like a mid-front-engine roadster -->
        <visual>
            <origin xyz="-0.4 0 ${ch_h/2 + body_h + cabin_h/2}" rpy="0 0 0" />
            <geometry>
                <box size="${cabin_l} ${cabin_w} ${cabin_h}" />
            </geometry>
            <material name="glass_dark">
                <color rgba="0.12 0.14 0.18 1.0" />
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 ${ch_h/2 + body_h/2}" rpy="0 0 0" />
            <geometry>
                <box size="${ch_l} ${ch_w} ${ch_h + body_h}" />
            </geometry>
        </collision>

        <!-- COM at the chassis frame origin (floor-pan center, 0.33 m up).
           In the SDF, chassis is lumped into base_link, so the simulated link
           origin is at ground level and the COM sits 0.33 m above it. The
           thruster plugin must take torques about the point where Fortress's
           physics system actually applies ExternalWorldWrenchCmd (link origin
           vs COM) - a Phase 2 sign test pins this down. -->
        <xacro:box_inertia m="${ch_mass}" x="${ch_l}" y="${ch_w}" z="${ch_h + body_h}" />
    </link>

    <!-- ===================== SUSPENSION MACRO ===================== -->
    <!-- One vertical spring-damper per corner (prismatic, +z = the wheel moves
       up relative to the chassis = compression). Without it the rigid car on
       four rigid wheels is statically indeterminate: the physics engine can put
       all the load on one diagonal, and did - traction control then had only two
       driven wheels and the climb sagged from 6 to 2.4 m/s (IMU-flown run
       imu_fly1, 2026-10-16); touchdown also peaked at 8-11 g.
       Sized for stunt loads, not road loads: ~4-5 g at the ramp bottom (fan +
       centripetal) means ~20 kN per corner, so k = 250 kN/m (~8 cm there) with
       +-0.12 m travel, damping at zeta ~0.5 on a corner's sprung mass.
       PRELOADED: at q = 0 each spring pushes with the quarter-chassis weight,
       so at rest (1 g) the joints sit at 0, keeping base_link at ground level
       and the chassis frame wheel_radius above it - constants the mission,
       estimator, analyzer and tests rely on.
       The spring-damper force is applied by the actuation system (JointForceCmd
       every physics step, <suspension> in its plugin block below): an SDF joint
       spring in this Fortress / DART build gave static deflections that did not
       scale with k (the implied corner load went from 5.9 to 6.5 kN between
       k = 250 and 500 kN/m), so it could not be trusted. -->
    <xacro:property name="susp_k" value="250000.0" />
    <xacro:property name="susp_travel" value="0.12" />
    <xacro:property name="susp_mass" value="10.0" />
    <!-- each spring carries a quarter of the chassis (steer links and wheels hang below it) -->
    <xacro:property name="susp_preload" value="${ch_mass * 9.81 / 4.0}" />
    <xacro:property name="susp_damping" value="${2.0 * 0.5 * sqrt(susp_k * ch_mass / 4.0)}" />
    <xacro:macro name="suspension" params="prefix x_off y_off">
        <joint name="${prefix}_suspension_joint" type="prismatic">
            <parent link="chassis" />
            <child link="${prefix}_suspension_link" />
            <origin xyz="${x_off} ${y_off} 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <limit lower="${-susp_travel}" upper="${susp_travel}" effort="100000.0" velocity="10.0" />
            <dynamics damping="0.0" />
        </joint>
        <link name="${prefix}_suspension_link">
            <inertial>
                <mass value="${susp_mass}" />
                <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05" />
            </inertial>
        </link>
    </xacro:macro>

    <!-- ===================== STEERING LINK MACRO ===================== -->
    <xacro:macro name="steering_link" params="prefix x_off y_off">
        <joint name="${prefix}_wheel_steering_joint" type="revolute">
            <parent link="${prefix}_suspension_link" />
            <child link="${prefix}_wheel_steering_link" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <axis xyz="0 0 1" />
            <!-- same mechanical stop and rate as the sedan; the drive
               controller must command less than this (sedan used 0.65 rad).
               effort 400 -> 3000 N.m: at 1,800 kg the standstill scrub torque
               of the line-contact cylinder tire (~ mu N w / 4 ~ 320 N.m per
               wheel, more once it twists) stalled the joint at 400 - a +0.3
               rad step moved 0.0001 rad; at 300 kg the same step settled in
               0.175 s (smoke test 2026-10-16). -->
            <limit lower="-0.80" upper="0.80" effort="3000.0" velocity="4.0" />
            <dynamics damping="0.0" />
        </joint>

        <link name="${prefix}_wheel_steering_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder radius="0.03" length="0.12" />
                </geometry>
                <material name="silver">
                    <color rgba="0.75 0.75 0.75 1.0" />
                </material>
            </visual>
            <inertial>
                <mass value="${steer_mass}" />
                <inertia ixx="0.01" ixy="0" ixz="0"
                    iyy="0.01" iyz="0"
                    izz="0.01" />
            </inertial>
        </link>
    </xacro:macro>

    <!-- ===================== WHEEL MACRO ===================== -->
    <xacro:macro name="wheel" params="name parent x_off y_off z_off">
        <joint name="${name}_joint" type="continuous">
            <parent link="${parent}" />
            <child link="${name}" />
            <origin xyz="${x_off} ${y_off} ${z_off}" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <limit effort="${wheel_effort_max}" velocity="${wheel_velocity_max}" />
        </joint>

        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
                <material name="tyre">
                    <color rgba="0.08 0.08 0.08 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
            </collision>
            <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
        </link>
    </xacro:macro>

    <!-- ===================== INSTANTIATE ===================== -->
    <xacro:suspension prefix="front_left" x_off="${wheelbase/2}" y_off="${track_width/2}" />
    <xacro:suspension prefix="front_right" x_off="${wheelbase/2}" y_off="${-track_width/2}" />
    <xacro:suspension prefix="rear_left" x_off="${-wheelbase/2}" y_off="${track_width/2}" />
    <xacro:suspension prefix="rear_right" x_off="${-wheelbase/2}" y_off="${-track_width/2}" />
    <xacro:steering_link prefix="front_left" x_off="${wheelbase/2}" y_off="${track_width/2}" />
    <xacro:steering_link prefix="front_right" x_off="${wheelbase/2}" y_off="${-track_width/2}" />

    <xacro:wheel name="front_left_wheel"
        parent="front_left_wheel_steering_link" x_off="0" y_off="0" z_off="0" />
    <xacro:wheel name="front_right_wheel"
        parent="front_right_wheel_steering_link" x_off="0" y_off="0" z_off="0" />
    <xacro:wheel name="rear_left_wheel"
        parent="rear_left_suspension_link" x_off="0" y_off="0" z_off="0" />
    <xacro:wheel name="rear_right_wheel"
        parent="rear_right_suspension_link" x_off="0" y_off="0" z_off="0" />

    <!-- ===================== WHEEL FRICTION ===================== -->
    <!-- same <gazebo reference><collision> blob path as the sedan (slip1/slip2
       are not in sdformat's flat whitelist); slip 0 for now - the sedan's
       slip was an EKF experiment, not a tire model. -->
    <xacro:macro name="wheel_friction" params="link slip:=0.00">
        <gazebo reference="${link}">
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>$(arg tire_mu)</mu>
                            <mu2>$(arg tire_mu)</mu2>
                            <slip1>${slip}</slip1>
                            <slip2>${slip}</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </gazebo>
    </xacro:macro>
    <xacro:wheel_friction link="front_left_wheel" />
    <xacro:wheel_friction link="front_right_wheel" />
    <xacro:wheel_friction link="rear_left_wheel" />
    <xacro:wheel_friction link="rear_right_wheel" />

    <!-- ===================== WHEEL FORCE/TORQUE SENSORS ===================== -->
    <!-- needs the world to load ignition-gazebo-forcetorque-system. Measured in
       the wheel (child) frame; the wheel spins about its own y, so consumers
       take |F| or rotate by the joint angle - the normal force is the
       component along the chassis z (or ramp normal). -->
    <xacro:macro name="wheel_ft" params="joint short">
        <gazebo reference="${joint}">
            <sensor name="ft_${short}" type="force_torque">
                <always_on>true</always_on>
                <update_rate>200</update_rate>
                <topic>roadster/wheel_wrench/${short}</topic>
                <force_torque>
                    <frame>child</frame>
                    <measure_direction>child_to_parent</measure_direction>
                </force_torque>
            </sensor>
        </gazebo>
    </xacro:macro>
    <xacro:wheel_ft joint="front_left_wheel_joint" short="fl" />
    <xacro:wheel_ft joint="front_right_wheel_joint" short="fr" />
    <xacro:wheel_ft joint="rear_left_wheel_joint" short="rl" />
    <xacro:wheel_ft joint="rear_right_wheel_joint" short="rr" />

    <!-- ===================== CHASSIS CONTACT SENSOR ===================== -->
    <!-- needs ignition-gazebo-contact-system in the world. Any contact on the
       body box (not the wheels) is a scrape or a bad landing. sdformat lumps
       the fixed-jointed chassis into base_link, which renames its collision -
       hence the lump-prefixed name (checked with `ign sdf -p`). -->
    <gazebo reference="chassis">
        <sensor name="body_contact" type="contact">
            <always_on>true</always_on>
            <update_rate>200</update_rate>
            <!-- no <topic>: Fortress's contact system ignores it and publishes
               on /world/<world>/model/roadster/link/base_link/sensor/
               body_contact/contact; the launch file bridges that name to
               /roadster/body_contact -->
            <contact>
                <collision>base_link_fixed_joint_lump__chassis_collision</collision>
            </contact>
        </sensor>
    </gazebo>

    <!-- ===================== NOZZLE FRAMES ===================== -->
    <!-- massless fixed frames: sdformat lumps them into chassis in the SDF,
       robot_state_publisher still publishes them as static TF for RViz.
       Frame x axis = force direction on the car. -->
    <xacro:macro name="nozzle_frame" params="name xyz dir">
        <joint name="nozzle_${name}_joint" type="fixed">
            <parent link="chassis" />
            <child link="nozzle_${name}" />
            <origin xyz="${xyz[0]} ${xyz[1]} ${xyz[2]}"
                rpy="0 ${-atan2(dir[2], sqrt(dir[0]*dir[0] + dir[1]*dir[1]))} ${atan2(dir[1], dir[0])}" />
        </joint>
        <link name="nozzle_${name}" />
    </xacro:macro>
    <xacro:macro name="nozzle_frames" params="names">
        <xacro:if value="${len(names) > 0}">
            <xacro:nozzle_frame name="${names[0]}"
                xyz="${nozzles[names[0]]['xyz']}" dir="${nozzles[names[0]]['force_dir']}" />
            <xacro:nozzle_frames names="${names[1:]}" />
        </xacro:if>
    </xacro:macro>
    <xacro:nozzle_frames names="${python.sorted(nozzles.keys())}" />

    <!-- ===================== IMU ===================== -->
    <joint name="imu_joint" type="fixed">
        <parent link="chassis" />
        <child link="imu_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <link name="imu_link">
        <inertial>
            <mass value="0.01" />
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </link>

    <xacro:macro name="imu_axis_noise" params="axis stddev bias">
        <xacro:element xacro:name="${axis}">
            <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>${stddev}</stddev>
                <bias_mean>0.0</bias_mean>
                <bias_stddev>${bias}</bias_stddev>
            </noise>
        </xacro:element>
    </xacro:macro>

    <!-- same noise model as the sedan. 1 kHz = the physics step (sedan: 100 Hz):
       the rigid wheels on the box-chain ramp take ~1 ms contact impulses (up to
       150 m/s^2) at every facet joint; sampled at 200 Hz an instantaneous IMU
       aliases them (a 1 ms spike integrated over 5 ms), which drove the IMU
       state estimate off by metres on the climb. A real IMU low-pass filters
       before sampling; sampling every physics step is the simulated equivalent. -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>1000</update_rate>
            <topic>imu</topic>
            <ignition_frame_id>imu_link</ignition_frame_id>
            <imu>
                <angular_velocity>
                    <xacro:imu_axis_noise axis="x" stddev="0.009" bias="0.0004" />
                    <xacro:imu_axis_noise axis="y" stddev="0.009" bias="0.0004" />
                    <xacro:imu_axis_noise axis="z" stddev="0.009" bias="0.0004" />
                </angular_velocity>
                <linear_acceleration>
                    <xacro:imu_axis_noise axis="x" stddev="0.08" bias="0.005" />
                    <xacro:imu_axis_noise axis="y" stddev="0.08" bias="0.005" />
                    <xacro:imu_axis_noise axis="z" stddev="0.08" bias="0.005" />
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <!-- ===================== GAZEBO: GROUND-TRUTH ODOMETRY ===================== -->
    <gazebo>
        <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
            <dimensions>3</dimensions>
            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <odom_publish_frequency>200</odom_publish_frequency>
            <odom_topic>/model/roadster/odometry_truth</odom_topic>
            <tf_topic>/model/roadster/tf_truth</tf_topic>
        </plugin>
    </gazebo>

    <!-- ===================== ROS2_CONTROL ===================== -->
    <ros2_control name="RoadsterDrive" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <xacro:macro name="effort_wheel" params="joint">
            <joint name="${joint}">
                <command_interface name="effort">
                    <param name="min">${-wheel_effort_max}</param>
                    <param name="max">${wheel_effort_max}</param>
                </command_interface>
                <state_interface name="position" />
                <state_interface name="velocity" />
                <state_interface name="effort" />
            </joint>
        </xacro:macro>
        <xacro:macro name="position_steer" params="joint">
            <joint name="${joint}">
                <command_interface name="position">
                    <param name="min">-0.75</param>
                    <param name="max">0.75</param>
                </command_interface>
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </xacro:macro>
        <xacro:effort_wheel joint="front_left_wheel_joint" />
        <xacro:effort_wheel joint="front_right_wheel_joint" />
        <xacro:effort_wheel joint="rear_left_wheel_joint" />
        <xacro:effort_wheel joint="rear_right_wheel_joint" />
        <xacro:position_steer joint="front_left_wheel_steering_joint" />
        <xacro:position_steer joint="front_right_wheel_steering_joint" />
        <!-- suspension: passive springs, state only (joint_state_broadcaster
           publishes them so robot_state_publisher can place the wheels, and the
           state estimator reads the travel for its wheel-centre lever) -->
        <xacro:macro name="passive_joint" params="joint">
            <joint name="${joint}">
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </xacro:macro>
        <xacro:passive_joint joint="front_left_suspension_joint" />
        <xacro:passive_joint joint="front_right_suspension_joint" />
        <xacro:passive_joint joint="rear_left_suspension_joint" />
        <xacro:passive_joint joint="rear_right_suspension_joint" />
    </ros2_control>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controllers_file)</parameters>
        </plugin>
    </gazebo>

    <!-- ===================== STUNT ACTUATION ===================== -->
    <!-- tank + 10 cold-gas nozzles + suction fan, all in one force-writing
       system (roadster_gz_plugins). Parameter sources and confidence:
       docs/plans/roadster_demo_plan.md sections 2 and 7. Force magnitudes are
       multiples of the model's total weight, computed by the plugin. -->
    <gazebo>
        <plugin filename="roadster_actuation_system"
            name="roadster_gz_plugins::RoadsterActuationSystem">
            <link_name>base_link</link_name>
            <!-- chassis frame (nozzles.yaml) relative to the SDF link: chassis
               is lumped into base_link, wheel_radius above it -->
            <frame_offset>0 0 ${wheel_radius}</frame_offset>
            <nozzles_file>$(find roadster_description)/config/nozzles.yaml</nozzles_file>
            <surfaces_file>$(arg surfaces_file)</surfaces_file>
            <state_rate_hz>200</state_rate_hz>
            <tank>
                <volume_m3>0.6</volume_m3>
                <p0_bar>400</p0_bar>
                <temperature_k>293</temperature_k>
                <p_reg_bar>100</p_reg_bar>
                <p_min_bar>25</p_min_bar>
                <feed_mode>regulated</feed_mode>
            </tank>
            <nozzle_defaults>
                <tau_rise_s>0.02</tau_rise_s>
                <tau_fall_s>0.02</tau_fall_s>
                <min_on_time_s>0.02</min_on_time_s>
                <exhaust_velocity>350</exhaust_velocity>
            </nozzle_defaults>
            <fan>
                <!-- 1.5 m g: inverted hold needs > 1 m g (plan section 3) -->
                <f_max_mg>1.5</f_max_mg>
                <tau_s>0.3</tau_s>
                <h_seal_m>0.35</h_seal_m>
                <h_max_m>1.0</h_max_m>
                <!-- floor-pan underside center, chassis frame -->
                <point>0 0 ${-ch_h/2}</point>
                <max_surface_angle_deg>45</max_surface_angle_deg>
                <initial_speed>$(arg fan_initial_speed)</initial_speed>
            </fan>
            <!-- suspension spring-dampers (see the SUSPENSION MACRO comment):
               joint force = -(preload + k q + c dq/dt) -->
            <suspension>
                <joints>front_left_suspension_joint front_right_suspension_joint
                    rear_left_suspension_joint rear_right_suspension_joint</joints>
                <stiffness>${susp_k}</stiffness>
                <damping>${susp_damping}</damping>
                <preload>${susp_preload}</preload>
            </suspension>
            <!-- drive the particle emitters below (rate = level x rate_max per s) -->
            <effects>
                <enabled>$(arg with_effects)</enabled>
                <rate_max>200</rate_max>
                <fan_rate_max>120</fan_rate_max>
                <topic_prefix>/roadster/fx</topic_prefix>
            </effects>
        </plugin>
    </gazebo>

    <!-- ===================== VISUAL EFFECTS (Gazebo particles) ===================== -->
    <!-- Cosmetic only, no physics. One emitter per nozzle at its exit, its +X
       along the EXHAUST (opposite force_dir), so a firing nozzle shows a white
       cold-gas plume; two on the rear deck show the suction fans' exhaust (the
       ducted fans pull air from under the floor and blow it out above). All
       start off; the actuation system switches them and sets their rate from
       the live thrust / fan speed on /roadster/fx/<name>. Needs the world to
       load ignition-gazebo-particle-emitter2-system. Attached to base_link
       (the root link sdformat keeps) with explicit poses, so lumping cannot
       move them. -->
    <xacro:macro name="fx_emitter" params="name xyz exhaust rgb">
        <particle_emitter name="fx_${name}" type="point">
            <pose>${xyz[0]} ${xyz[1]} ${xyz[2] + wheel_radius} 0 ${-atan2(exhaust[2], sqrt(exhaust[0]*exhaust[0] + exhaust[1]*exhaust[1]))} ${atan2(exhaust[1], exhaust[0])}</pose>
            <emitting>false</emitting>
            <size>0.05 0.05 0.05</size>
            <particle_size>0.4 0.4 0.4</particle_size>
            <lifetime>0.5</lifetime>
            <rate>0</rate>
            <min_velocity>10</min_velocity>
            <max_velocity>16</max_velocity>
            <scale_rate>3</scale_rate>
            <color_start>${rgb} 0.9</color_start>
            <color_end>${rgb} 0.0</color_end>
            <topic>/roadster/fx/${name}</topic>
            <!-- soft round puff (scripts/generate_puff_texture.py) instead of hard squares -->
            <material>
                <diffuse>1 1 1 1</diffuse>
                <pbr>
                    <metal>
                        <albedo_map>$(find roadster_description)/models/fx/puff.png</albedo_map>
                    </metal>
                </pbr>
            </material>
        </particle_emitter>
    </xacro:macro>
    <xacro:macro name="fx_nozzles" params="names">
        <xacro:if value="${len(names) > 0}">
            <xacro:fx_emitter name="${names[0]}" xyz="${nozzles[names[0]]['xyz']}"
                exhaust="${[-c for c in nozzles[names[0]]['force_dir']]}" rgb="0.95 0.95 1.0" />
            <xacro:fx_nozzles names="${names[1:]}" />
        </xacro:if>
    </xacro:macro>
    <xacro:if value="$(arg with_effects)">
        <gazebo reference="base_link">
            <xacro:fx_nozzles names="${python.sorted(nozzles.keys())}" />
            <xacro:fx_emitter name="fan_left" xyz="${[-1.8, 0.5, 0.7]}"
                exhaust="${[-0.45, 0.0, 0.89]}" rgb="0.55 0.8 1.0" />
            <xacro:fx_emitter name="fan_right" xyz="${[-1.8, -0.5, 0.7]}"
                exhaust="${[-0.45, 0.0, 0.89]}" rgb="0.55 0.8 1.0" />
        </gazebo>
    </xacro:if>

    <!-- ===================== OPTIONAL RGB-D CAMERA ===================== -->
    <!-- verbatim from sedan.urdf.xacro (424x300, hfov 1.9, 10 Hz, far 50 m);
       see the sedan file for why each value is what it is. Same topic names,
       so lane_node can run on this car on a flat world if ever needed. -->
    <xacro:if value="$(arg with_camera)">
        <joint name="front_camera_joint" type="fixed">
            <parent link="chassis" />
            <child link="front_camera_link" />
            <origin xyz="${cam_x} 0 ${cam_z - wheel_radius}" rpy="0 ${cam_pitch} 0" />
        </joint>

        <link name="front_camera_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.05 0.12 0.05" />
                </geometry>
                <material name="lens">
                    <color rgba="0.05 0.05 0.05 1.0" />
                </material>
            </visual>
            <inertial>
                <mass value="0.2" />
                <inertia ixx="0.0001" ixy="0" ixz="0"
                    iyy="0.0001" iyz="0"
                    izz="0.0001" />
            </inertial>
        </link>

        <joint name="front_camera_optical_joint" type="fixed">
            <parent link="front_camera_link" />
            <child link="front_camera_optical_frame" />
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
        </joint>
        <link name="front_camera_optical_frame" />

        <gazebo reference="front_camera_link">
            <sensor name="front_camera" type="rgbd_camera">
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <camera>
                    <horizontal_fov>1.9</horizontal_fov>
                    <image>
                        <width>424</width>
                        <height>300</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.3</near>
                        <far>50.0</far>
                    </clip>
                    <depth_camera>
                        <output>depths</output>
                    </depth_camera>
                </camera>
                <topic>camera/front</topic>
                <ignition_frame_id>front_camera_optical_frame</ignition_frame_id>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>
